{
  "manifest_version": 1,
  "kind": "component",
  "key": "countdown",
  "name": "倒计时",
  "version": "1.2.0",
  "description": "支持自定义时长或指定年月日时分秒时刻的倒计时，结束时播放提示音，状态随笔记保存，可置顶为全局浮窗。",
  "author": "Kiwi",
  "icon": "clock",
  "homepage": "",
  "entry": "index.js",
  "style": "style.css",
  "blocks": [
    {
      "type": "countdown",
      "label": "倒计时",
      "icon": "clock",
      "description": "按自定义时长或指定时刻倒计时，可置顶为跨页面浮窗",
      "category": "效率",
      "default_props": {
        "title": "倒计时",
        "mode": "duration",
        "durationSeconds": 600,
        "remaining": 600,
        "running": false,
        "endsAt": 0,
        "startedAt": 0,
        "targetAt": 0,
        "soundEnabled": true,
        "completedCount": 0
      },
      "pinnable": true
    }
  ],
  "settings": []
}
