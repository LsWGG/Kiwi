# ===== Kiwi Docker 生产部署环境模板 =====
# 推荐直接运行 ./deploy.sh：交互向导会按需询问访问地址、访问令牌、
# Cloudflare 隧道等，并自动生成随机密码与 Fernet 密钥。
# 也可 cp .env.prod.example .env.prod 后手动填写。
# .env.prod 含密钥，已加入 .gitignore，请勿提交。

# --- 访问地址（用于 CORS 与文档示例）---
# 部署到服务器时改成实际地址，例如 http://192.168.1.20:18473
KIWI_PUBLIC_ORIGIN=http://localhost:18473

# --- 公网只读分享（可选）---
# 通过 Cloudflare Tunnel / 反向代理暴露分享页时，填写公网分享域名。
# 创建分享链接会直接使用该地址，避免从内网创建出 192.168.x.x 链接。
# 推荐运行 ./deploy.sh cloudflare：
#   选择「自动创建」时只需提供 Cloudflare API Token 与分享域名（可直接填域名，
#   脚本会自动补全 https://），脚本会创建/复用隧道、写入路径白名单 ingress 并添加
#   DNS 解析。所需权限：
#     整个账户 → Cloudflare Tunnel（或 Cloudflare One Connectors）→ 编辑
#     所有域名 → DNS → 编辑；所有域名 → Zone → 读取
#   账户级 Token（cfat_）还需要 Account ID，交互模式会提示输入；用户级 Token（cfut_）
#   不需要。API Token 只用于当次配置，不会写入本文件。
# 也可以先在 Zero Trust 创建隧道，再填写 CLOUDFLARE_TUNNEL_TOKEN，
# 并在 Public Hostname 中把 /share/、/api/share/、/assets/、/favicon 指向 http://frontend:80。
# KIWI_CLOUDFLARE_ENABLED=false
# CLOUDFLARE_TUNNEL_TOKEN=
# KIWI_PUBLIC_BASE_URL=https://share.example.com

# --- Web Push 提醒（可选）---
# 浏览器推送服务要求 mailto: 或 https: 开头的联系方式；VAPID 密钥自动生成并加密存储。
# KIWI_PUSH_CONTACT=mailto:you@example.com

# --- 语音转写（可选）---
# 模型首次使用时下载；Docker 部署建议把 KIWI_WHISPER_MODEL_DIR 挂载为持久卷。
# KIWI_WHISPER_MODEL=small
# KIWI_WHISPER_DEVICE=cpu
# KIWI_WHISPER_COMPUTE_TYPE=int8
# KIWI_WHISPER_LANGUAGE=auto

# --- 非常规端口（可改，避免与开发环境冲突）---
KIWI_HTTP_PORT=18473
KIWI_API_PORT=18474
POSTGRES_PORT=15432
QDRANT_HTTP_PORT=16333
QDRANT_GRPC_PORT=16334
# 默认只监听 127.0.0.1。若要让局域网内的本地开发实例直连，改成 0.0.0.0，
# 并用防火墙仅放行开发机 IP（不要暴露到公网）。
# POSTGRES_BIND=127.0.0.1
# QDRANT_BIND=127.0.0.1

# --- PostgreSQL ---
POSTGRES_USER=kiwi
POSTGRES_DB=kiwi
# 建议只用 URL 安全字符（字母、数字、- _），避免数据库连接串转义问题。
POSTGRES_PASSWORD=change_me_to_a_long_random_value

# --- 安全 ---
# Fernet 密钥，用于加密模型 API Key；生成后必须保持不变。
# 生成：python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
KIWI_FERNET_KEY=change_me_to_a_valid_fernet_key

# 可选访问控制。留空表示不启用（仅建议在 127.0.0.1 / 可信内网使用）；
# 设置后浏览器首次访问会要求输入该令牌，登录态通过 HttpOnly Cookie 保存。
# 生成：openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
# KIWI_ACCESS_TOKEN=change_me_to_a_long_random_token
# KIWI_ACCESS_COOKIE_NAME=kiwi_access

# 接口限流（每分钟，按客户端 IP；0 表示关闭该组）
# KIWI_RATE_LIMIT_ENABLED=true
# KIWI_RATE_LIMIT_LLM_PER_MINUTE=20
# KIWI_RATE_LIMIT_IMPORT_PER_MINUTE=10
# KIWI_RATE_LIMIT_CODE_PER_MINUTE=30

# --- 国内网络加速 ---
# 后端镜像构建时的 PyPI / Debian 镜像（默认清华源，海外网络可改回官方源）。
# PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
# PostgreSQL 16 客户端（pg_dump）的 PGDG 源；海外网络可改为官方地址。
# PGDG_MIRROR=https://mirrors.aliyun.com/postgresql/repos/apt
# 前端在宿主机构建（npm run build），如需加速可手动配置：
#   npm config set registry https://registry.npmmirror.com
# 嵌入模型下载镜像（默认已启用；海外网络可设为空字符串使用官方地址）。
HF_ENDPOINT=https://hf-mirror.com

# --- 嵌入模型（可选）---
# 默认 local：在本机运行 fastembed。若部署环境无法运行本地模型，
# 推荐在应用内「设置 → 向量模型」切换为线上接口；此处配置作为兜底生效。
# 注意：启用后笔记与 Wiki 文本会发送到该接口。
KIWI_EMBED_PROVIDER=local
# KIWI_EMBED_API_BASE=https://api.openai.com/v1
# KIWI_EMBED_API_KEY=sk-...
# KIWI_EMBED_API_MODEL=text-embedding-3-small
# KIWI_EMBED_API_TIMEOUT=60
# KIWI_EMBED_API_BATCH_SIZE=64
# KIWI_EMBED_API_CONCURRENCY=4

# --- 检索 ---
# 最低余弦相似度：低于该分数的内容不会进入问答上下文与引用列表（0 关闭过滤）
# KIWI_RETRIEVAL_MIN_SCORE=0.4

# --- 自动备份 ---
# 后端每小时检查一次是否到期；备份写入数据卷 /app/data/backups，
# 也可在「设置 → 运维」手动触发，或用 scripts/backup.sh 在宿主机执行。
# KIWI_BACKUP_ENABLED=true
# KIWI_BACKUP_INTERVAL_HOURS=24
# KIWI_BACKUP_RETENTION_DAYS=14

# --- 运维数据保留 ---
# 后台任务与审计日志仅保留最近 N 天；0 表示不自动清理。
# KIWI_OPS_RETENTION_DAYS=14

# --- 可选 ---
# LLM 超时（秒），本地大模型可适当加大
# KIWI_LLM_TIMEOUT=600
# 本地开发实例直连生产库时设为 false，避免演示库种子、向量巡检与定时任务
# 向共享数据写入；生产部署保持默认 true。
# KIWI_BACKGROUND_JOBS=true
# 持久化任务 worker：独立于 KIWI_BACKGROUND_JOBS。设为 false 时导入与编译
# 只会排队、不会执行；本地实例仍需处理手动任务时保持默认 true。
# KIWI_JOB_WORKER_ENABLED=true
# 时区
# TZ=Asia/Shanghai
