# ===== Kiwi Docker 生产部署环境模板 =====
# cp .env.prod.example .env.prod
# 或直接运行 ./deploy.sh：首次启动会自动生成随机密码与 Fernet 密钥。
# .env.prod 含密钥，已加入 .gitignore，请勿提交。

# --- 访问地址（用于 CORS 与文档示例）---
# 部署到服务器时改成实际地址，例如 http://192.168.1.20:18473
KIWI_PUBLIC_ORIGIN=http://localhost:18473

# --- 非常规端口（可改，避免与开发环境冲突）---
KIWI_HTTP_PORT=18473
KIWI_API_PORT=18474
POSTGRES_PORT=15432
QDRANT_HTTP_PORT=16333
QDRANT_GRPC_PORT=16334

# --- PostgreSQL ---
POSTGRES_USER=kiwi
POSTGRES_DB=kiwi
# 建议只用 URL 安全字符（字母、数字、- _），避免数据库连接串转义问题。
POSTGRES_PASSWORD=change_me_to_a_long_random_value

# --- 安全 ---
# Fernet 密钥，用于加密模型 API Key；生成后必须保持不变。
# 生成：python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
KIWI_FERNET_KEY=change_me_to_a_valid_fernet_key

# --- 可选 ---
# 模型下载镜像（网络受限时使用）
# HF_ENDPOINT=https://hf-mirror.com
# LLM 超时（秒），本地大模型可适当加大
# KIWI_LLM_TIMEOUT=600
# 时区
# TZ=Asia/Shanghai
