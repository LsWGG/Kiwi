# 构建上下文只保留源码与部署物料，避免把本地依赖、运行数据与密钥送进镜像。
.git
.gitignore
.env
.env.prod
.env.*.local

# Python
backend/.venv
backend/.ruff_cache
backend/.pytest_cache
backend/**/__pycache__
backend/**/*.py[cod]
backend/data
backend/node_modules
backend/package.json
backend/package-lock.json

# Node / 前端依赖与中间产物
# 注意：frontend/dist 不排除——可选的前端运行时镜像需要把预构建产物 COPY 进去；
# 生产 Compose 则直接挂载该目录，不经过 docker build。
frontend/node_modules
frontend/.vite
frontend/tsconfig.tsbuildinfo

# 文档与截图不参与运行
docs
*.log
