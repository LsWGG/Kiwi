# ===== Kiwi 环境变量模板 =====
# 复制为 .env：cp .env.example .env
# run.sh 首次运行会自动生成 .env（含随机密钥），本模板供手动配置参考

# --- 数据库 (PostgreSQL 16) ---
POSTGRES_USER=kiwi
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kiwi
POSTGRES_PORT=5432

# --- 向量库 (Qdrant) ---
QDRANT_PORT=6333

# --- 后端 ---
KIWI_DATABASE_URL=postgresql+asyncpg://kiwi:change_me@localhost:5432/kiwi
KIWI_QDRANT_URL=http://localhost:6333
# 持久化任务 worker：设为 false 时导入 / 编译只会排队，不会执行。
# KIWI_JOB_WORKER_ENABLED=true

# --- 安全 ---
# Fernet 密钥（32 bytes urlsafe base64），用于加密 LLM API 密钥，auto 生成后勿外泄
KIWI_FERNET_KEY=change_me_change_me_change_me_change_me_

# --- 公网只读分享（可选）---
# 通过 Cloudflare Tunnel 暴露 /share/ 时填写公网域名；留空使用当前访问地址。
# KIWI_PUBLIC_BASE_URL=https://share.example.com

# --- Web Push 提醒（可选）---
# 浏览器推送服务要求 mailto: 或 https: 开头的联系方式；密钥在应用内自动生成。
# KIWI_PUSH_CONTACT=mailto:you@example.com

# --- 语音转写（可选）---
# 首次使用会把 faster-whisper 模型下载到 KIWI_WHISPER_MODEL_DIR。
# KIWI_WHISPER_MODEL=small
# KIWI_WHISPER_DEVICE=cpu
# KIWI_WHISPER_COMPUTE_TYPE=int8
# KIWI_WHISPER_LANGUAGE=auto

# --- 可选：embedding 模型下载镜像（HF 可达可留空）---
# HF_ENDPOINT=https://hf-mirror.com

# --- 可选：线上 embedding（部署环境无法运行本地模型时）---
# 推荐在应用内「设置 → 向量模型」配置；此处仅作为未保存应用内配置时的兜底。
# KIWI_EMBED_PROVIDER=openai
# KIWI_EMBED_API_BASE=https://api.openai.com/v1
# KIWI_EMBED_API_KEY=sk-...
# KIWI_EMBED_API_MODEL=text-embedding-3-small

# --- 可选：检索最低相似度（低于该分数不进入问答上下文与引用；0 关闭）---
# KIWI_RETRIEVAL_MIN_SCORE=0.4
