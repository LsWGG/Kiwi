      "id": "nb-md-1",
      "type": "markdown",
      "source": "# 学习记录分析\n\n> 数据范围：2026-10-06 至 2026-10-18 ｜ 分析人：许澄\n>\n> 这个 Notebook 演示三件事：用 pandas 汇总学习记录、把结果渲染成 KPI 面板与掌握度分布图、把结论写回同一篇文档。代码单元格可以直接运行。\n\n下面的数据来自本库「学习」页的知识点掌握度与练习记录（已做脱敏与取整）。"
    },
    {
      "id": "nb-code-1",
      "type": "code",
      "source": "import pandas as pd\nfrom string import Template\n\nrecords = [\n    (\"笔记工作区\", 0.86, 12, 11),\n    (\"双向链接\", 0.80, 10, 9),\n    (\"知识库\", 0.78, 9, 8),\n    (\"Wiki 编译\", 0.72, 11, 9),\n    (\"学习图谱\", 0.68, 8, 6),\n    (\"学习闭环\", 0.65, 6, 5),\n    (\"画布\", 0.62, 7, 5),\n    (\"Notebook\", 0.58, 6, 4),\n    (\"学习模式\", 0.57, 9, 6),\n    (\"数据表视图\", 0.54, 7, 4),\n    (\"间隔重复\", 0.40, 8, 4),\n    (\"导入流水线\", 0.34, 6, 3),\n    (\"仿真考试\", 0.31, 5, 2),\n]\n\ndf = pd.DataFrame(records, columns=[\"知识点\", \"掌握度\", \"练习题\", \"答对\"])\ndf[\"正确率\"] = (df[\"答对\"] / df[\"练习题\"] * 100).round(0).astype(int)\n\n\nclass Panel:\n    \"\"\"让内核把 HTML 作为富输出渲染，而不是打印对象。\"\"\"\n\n    def __init__(self, html):\n        self.html = html\n\n    def __repr__(self):\n        return \"Kiwi 学习数据面板\"\n\n    def _repr_html_(self):\n        return self.html\n\n\navg = df[\"掌握度\"].mean()\naccuracy = df[\"答对\"].sum() / df[\"练习题\"].sum()\npending = int((df[\"掌握度\"] < 0.45).sum())\n\nCARD = Template(\"\"\"\n<div style=\"padding:12px 14px;border-radius:12px;background:rgba(148,163,184,.07);border:1px solid rgba(148,163,184,.13);\">\n  <div style=\"font-size:10px;letter-spacing:.08em;color:#8fa0bf;\">$label</div>\n  <div style=\"display:flex;align-items:baseline;gap:6px;margin-top:4px;white-space:nowrap;\">\n    <span style=\"font-size:23px;font-weight:700;letter-spacing:-.03em;color:$color;font-variant-numeric:tabular-nums;\">$value</span>\n    <span style=\"font-size:10px;color:#8294b3;\">$note</span>\n  </div>\n</div>\"\"\")\n\ncards = \"\".join(\n    CARD.substitute(label=label, value=value, note=note, color=color)\n    for label, value, note, color in [\n        (\"总正确率\", f\"{accuracy:.0%}\", \"76 / 104 题\", \"#67e8f9\"),\n        (\"练习总量\", f\"{df['练习题'].sum()}\", \"13 个知识点\", \"#c4b5fd\"),\n        (\"待加强\", str(pending), \"掌握度 < 45%\", \"#fbbf24\"),\n    ]\n)\n\nPANEL = Template(\"\"\"\n<div style=\"position:relative;overflow:hidden;padding:20px 22px 18px;border-radius:16px;color:#e2e8f0;background:linear-gradient(145deg,#0b1220 0%,#101a2f 55%,#0d1526 100%);border:1px solid rgba(148,163,184,.16);box-shadow:0 18px 50px -24px rgba(15,23,42,.65);\">\n  <div style=\"position:absolute;top:-80px;right:-40px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(139,92,246,.25),rgba(139,92,246,0) 68%);\"></div>\n  <div style=\"position:absolute;bottom:-110px;left:-50px;width:230px;height:230px;border-radius:50%;background:radial-gradient(circle,rgba(34,211,238,.13),rgba(34,211,238,0) 70%);\"></div>\n  <div style=\"position:relative;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px;\">\n    <div>\n      <div style=\"font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:#7c8db5;\">Learning Pulse</div>\n      <div style=\"margin-top:5px;font-size:18px;font-weight:600;letter-spacing:-.02em;color:#f1f5f9;\">学习记录概览</div>\n    </div>\n    <div style=\"font-size:10.5px;color:#8294b3;letter-spacing:.04em;white-space:nowrap;\">2026.10.06 — 10.18</div>\n  </div>\n  <div style=\"position:relative;display:flex;align-items:center;gap:22px;flex-wrap:wrap;\">\n    <div style=\"display:flex;align-items:center;gap:14px;min-width:196px;\">\n      <div style=\"width:94px;height:94px;border-radius:50%;background:conic-gradient(#a78bfa 0 $ring%,rgba(148,163,184,.16) $ring% 100%);display:grid;place-items:center;box-shadow:0 0 0 1px rgba(167,139,250,.2),0 0 32px rgba(139,92,246,.26);\">\n        <div style=\"width:70px;height:70px;border-radius:50%;background:#0d1628;display:grid;place-items:center;text-align:center;\">\n          <div>\n            <div style=\"font-size:20px;font-weight:700;letter-spacing:-.03em;color:#fff;font-variant-numeric:tabular-nums;\">$avg</div>\n            <div style=\"margin-top:1px;font-size:8.5px;letter-spacing:.1em;color:#8294b3;\">平均掌握度</div>\n          </div>\n        </div>\n      </div>\n      <div style=\"font-size:10.5px;line-height:1.9;color:#8294b3;white-space:nowrap;\">\n        <div><span style=\"color:#a78bfa;\">●</span> 13 个知识点</div>\n        <div><span style=\"color:#22d3ee;\">●</span> 104 次作答</div>\n        <div><span style=\"color:#fbbf24;\">●</span> 3 个待加强</div>\n      </div>\n    </div>\n    <div style=\"flex:1;min-width:300px;display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;\">\n      $cards\n    </div>\n  </div>\n</div>\"\"\")\n\ndisplay(Panel(PANEL.substitute(ring=int(avg * 100), avg=f\"{avg:.0%}\", cards=cards)))\n",
      "outputs": [
        {
          "type": "execute_result",
          "text": "Kiwi 学习数据面板",
          "html": "\n<div style=\"position:relative;overflow:hidden;padding:20px 22px 18px;border-radius:16px;color:#e2e8f0;background:linear-gradient(145deg,#0b1220 0%,#101a2f 55%,#0d1526 100%);border:1px solid rgba(148,163,184,.16);box-shadow:0 18px 50px -24px rgba(15,23,42,.65);\">\n  <div style=\"position:absolute;top:-80px;right:-40px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(139,92,246,.25),rgba(139,92,246,0) 68%);\"></div>\n  <div style=\"position:absolute;bottom:-110px;left:-50px;width:230px;height:230px;border-radius:50%;background:radial-gradient(circle,rgba(34,211,238,.13),rgba(34,211,238,0) 70%);\"></div>\n  <div style=\"position:relative;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px;\">\n    <div>\n      <div style=\"font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:#7c8db5;\">Learning Pulse</div>\n      <div style=\"margin-top:5px;font-size:18px;font-weight:600;letter-spacing:-.02em;color:#f1f5f9;\">学习记录概览</div>\n    </div>\n    <div style=\"font-size:10.5px;color:#8294b3;letter-spacing:.04em;white-space:nowrap;\">2026.10.06 — 10.18</div>\n  </div>\n  <div style=\"position:relative;display:flex;align-items:center;gap:22px;flex-wrap:wrap;\">\n    <div style=\"display:flex;align-items:center;gap:14px;min-width:196px;\">\n      <div style=\"width:94px;height:94px;border-radius:50%;background:conic-gradient(#a78bfa 0 60%,rgba(148,163,184,.16) 60% 100%);display:grid;place-items:center;box-shadow:0 0 0 1px rgba(167,139,250,.2),0 0 32px rgba(139,92,246,.26);\">\n        <div style=\"width:70px;height:70px;border-radius:50%;background:#0d1628;display:grid;place-items:center;text-align:center;\">\n          <div>\n            <div style=\"font-size:20px;font-weight:700;letter-spacing:-.03em;color:#fff;font-variant-numeric:tabular-nums;\">60%</div>\n            <div style=\"margin-top:1px;font-size:8.5px;letter-spacing:.1em;color:#8294b3;\">平均掌握度</div>\n          </div>\n        </div>\n      </div>\n      <div style=\"font-size:10.5px;line-height:1.9;color:#8294b3;white-space:nowrap;\">\n        <div><span style=\"color:#a78bfa;\">●</span> 13 个知识点</div>\n        <div><span style=\"color:#22d3ee;\">●</span> 104 次作答</div>\n        <div><span style=\"color:#fbbf24;\">●</span> 3 个待加强</div>\n      </div>\n    </div>\n    <div style=\"flex:1;min-width:300px;display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;\">\n      \n<div style=\"padding:12px 14px;border-radius:12px;background:rgba(148,163,184,.07);border:1px solid rgba(148,163,184,.13);\">\n  <div style=\"font-size:10px;letter-spacing:.08em;color:#8fa0bf;\">总正确率</div>\n  <div style=\"display:flex;align-items:baseline;gap:6px;margin-top:4px;white-space:nowrap;\">\n    <span style=\"font-size:23px;font-weight:700;letter-spacing:-.03em;color:#67e8f9;font-variant-numeric:tabular-nums;\">73%</span>\n    <span style=\"font-size:10px;color:#8294b3;\">76 / 104 题</span>\n  </div>\n</div>\n<div style=\"padding:12px 14px;border-radius:12px;background:rgba(148,163,184,.07);border:1px solid rgba(148,163,184,.13);\">\n  <div style=\"font-size:10px;letter-spacing:.08em;color:#8fa0bf;\">练习总量</div>\n  <div style=\"display:flex;align-items:baseline;gap:6px;margin-top:4px;white-space:nowrap;\">\n    <span style=\"font-size:23px;font-weight:700;letter-spacing:-.03em;color:#c4b5fd;font-variant-numeric:tabular-nums;\">104</span>\n    <span style=\"font-size:10px;color:#8294b3;\">13 个知识点</span>\n  </div>\n</div>\n<div style=\"padding:12px 14px;border-radius:12px;background:rgba(148,163,184,.07);border:1px solid rgba(148,163,184,.13);\">\n  <div style=\"font-size:10px;letter-spacing:.08em;color:#8fa0bf;\">待加强</div>\n  <div style=\"display:flex;align-items:baseline;gap:6px;margin-top:4px;white-space:nowrap;\">\n    <span style=\"font-size:23px;font-weight:700;letter-spacing:-.03em;color:#fbbf24;font-variant-numeric:tabular-nums;\">3</span>\n    <span style=\"font-size:10px;color:#8294b3;\">掌握度 < 45%</span>\n  </div>\n</div>\n    </div>\n  </div>\n</div>"
