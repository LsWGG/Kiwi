    {
      "id": "nb-code-2",
      "type": "code",
      "source": "from string import Template\n\nBAR = Template(\"\"\"\n<div style=\"min-width:0;\">\n  <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:5px;\">\n    <span style=\"font-size:11.5px;color:#cbd5e1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">$name</span>\n    <span style=\"font-size:10.5px;color:$color;font-variant-numeric:tabular-nums;\">$mastery%</span>\n  </div>\n  <div style=\"position:relative;height:6px;border-radius:999px;background:rgba(148,163,184,.14);\">\n    <div style=\"width:$mastery%;height:100%;border-radius:999px;background:linear-gradient(90deg,$c1,$c2);box-shadow:0 0 12px $glow;\"></div>\n    <div style=\"position:absolute;left:$accuracy%;top:-2px;width:1.5px;height:10px;border-radius:2px;background:rgba(226,232,240,.72);\" title=\"正确率 $accuracy%\"></div>\n  </div>\n</div>\"\"\")\n\n\ndef bar(name, mastery, accuracy):\n    if mastery < 0.45:\n        c1, c2, glow = \"#f59e0b\", \"#fbbf24\", \"rgba(251,191,36,.45)\"\n    elif mastery < 0.65:\n        c1, c2, glow = \"#7c3aed\", \"#a78bfa\", \"rgba(167,139,250,.45)\"\n    else:\n        c1, c2, glow = \"#0d9488\", \"#34d399\", \"rgba(52,211,153,.4)\"\n    return BAR.substitute(\n        name=name,\n        mastery=int(mastery * 100),\n        accuracy=int(accuracy),\n        color=c2,\n        c1=c1,\n        c2=c2,\n        glow=glow,\n    )\n\n\nranked = df.sort_values(\"掌握度\")\nrows = \"\".join(\n    bar(row[\"知识点\"], row[\"掌握度\"], row[\"正确率\"])\n    for _, row in ranked.iterrows()\n)\n\nPANEL = Template(\"\"\"\n<div style=\"position:relative;overflow:hidden;padding:20px 22px 18px;border-radius:16px;color:#e2e8f0;background:linear-gradient(145deg,#0b1220 0%,#111a2e 55%,#0d1526 100%);border:1px solid rgba(148,163,184,.16);box-shadow:0 18px 50px -24px rgba(15,23,42,.65);\">\n  <div style=\"position:absolute;top:-90px;right:-30px;width:250px;height:250px;border-radius:50%;background:radial-gradient(circle,rgba(34,211,238,.18),rgba(34,211,238,0) 68%);\"></div>\n  <div style=\"position:relative;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;\">\n    <div>\n      <div style=\"font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:#7c8db5;\">Mastery Map</div>\n      <div style=\"margin-top:5px;font-size:18px;font-weight:600;letter-spacing:-.02em;color:#f1f5f9;\">掌握度分布</div>\n      <div style=\"margin-top:3px;font-size:10.5px;color:#8294b3;\">按掌握度升序 · 越低越需要优先复习</div>\n    </div>\n    <div style=\"display:flex;gap:16px;align-items:center;padding-top:4px;font-size:10px;color:#8294b3;white-space:nowrap;\">\n      <span><span style=\"display:inline-block;width:14px;height:5px;border-radius:99px;background:linear-gradient(90deg,#7c3aed,#a78bfa);vertical-align:middle;margin-right:5px;\"></span>掌握度</span>\n      <span><span style=\"display:inline-block;width:2px;height:10px;border-radius:2px;background:rgba(226,232,240,.72);vertical-align:middle;margin-right:5px;\"></span>正确率</span>\n    </div>\n  </div>\n  <div style=\"position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(195px,1fr));gap:12px 22px;margin-top:16px;\">\n    $rows\n  </div>\n  <div style=\"position:relative;display:flex;align-items:baseline;gap:10px;margin-top:16px;padding:11px 14px;border-radius:11px;background:linear-gradient(90deg,rgba(251,191,36,.13),rgba(139,92,246,.07));border:1px solid rgba(251,191,36,.2);\">\n    <span style=\"font-size:9px;font-weight:600;letter-spacing:.14em;padding:3px 7px;border-radius:999px;background:rgba(251,191,36,.16);color:#fbbf24;\">NEXT</span>\n    <span style=\"font-size:11px;line-height:1.6;color:#cbd5e1;\">先清空到期复习，再对 <span style=\"color:#fbbf24;\">仿真考试</span> 与 <span style=\"color:#fbbf24;\">导入流水线</span> 各做一轮定向训练。</span>\n  </div>\n</div>\"\"\")\n\ndisplay(Panel(PANEL.substitute(rows=rows)))\n",
