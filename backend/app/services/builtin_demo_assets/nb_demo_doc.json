          "text": "Kiwi 学习数据面板",
          "html": "\n<div style=\"position:relative;overflow:hidden;padding:20px 22px 18px;border-radius:16px;color:#e2e8f0;background:linear-gradient(145deg,#0b1220 0%,#111a2e 55%,#0d1526 100%);border:1px solid rgba(148,163,184,.16);box-shadow:0 18px 50px -24px rgba(15,23,42,.65);\">\n  <div style=\"position:absolute;top:-90px;right:-30px;width:250px;height:250px;border-radius:50%;background:radial-gradient(circle,rgba(34,211,238,.18),rgba(34,211,238,0) 68%);\"></div>\n  <div style=\"position:relative;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;\">\n    <div>\n      <div style=\"font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:#7c8db5;\">Mastery Map</div>\n      <div style=\"margin-top:5px;font-size:18px;font-weight:600;letter-spacing:-.02em;color:#f1f5f9;\">掌握度分布</div>\n      <div style=\"margin-top:3px;font-size:10.5px;color:#8294b3;\">按掌握度升序 · 越低越需要优先复习</div>\n    </div>\n    <div style=\"display:flex;gap:16px;align-items:center;padding-top:4px;font-size:10px;color:#8294b3;white-space:nowrap;\">\n      <span><span style=\"display:inline-block;width:14px;height:5px;border-radius:99px;background:linear-gradient(90deg,#7c3aed,#a78bfa);vertical-align:middle;margin-right:5px;\"></span>掌握度</span>\n      <span><span style=\"display:inline-block;width:2px;height:10px;border-radius:2px;background:rgba(226,232,240,.72);vertical-align:middle;margin-right:5px;\"></span>正确率</span>\n    </div>\n  </div>\n  <div style=\"position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(195px,1fr));gap:12px 22px;margin-top:16px;\">\n    \n<div style=\"min-width:0;\">\n  <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:5px;\">\n    <span style=\"font-size:11.5px;color:#cbd5e1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">仿真考试</span>\n    <span style=\"font-size:10.5px;color:#fbbf24;font-variant-numeric:tabular-nums;\">31%</span>\n  </div>\n 