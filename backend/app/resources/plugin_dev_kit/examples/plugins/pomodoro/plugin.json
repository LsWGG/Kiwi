{
  "manifest_version": 1,
  "kind": "component",
  "key": "pomodoro",
  "name": "番茄钟",
  "version": "1.0.0",
  "description": "专注 / 休息循环计时器，支持开始、暂停、跳过与完成轮数统计，状态随笔记保存。",
  "author": "Kiwi",
  "icon": "target",
  "homepage": "",
  "entry": "index.js",
  "style": "style.css",
  "blocks": [
    {
      "type": "pomodoro",
      "label": "番茄钟",
      "icon": "target",
      "description": "插入一个 25 分钟专注 + 5 分钟休息的番茄钟",
      "category": "效率",
      "default_props": {
        "focusMinutes": 25,
        "breakMinutes": 5,
        "phase": "focus",
        "running": false,
        "endsAt": 0,
        "remaining": 1500,
        "completedFocus": 0
      },
      "pinnable": true
    }
  ],
  "settings": []
}
