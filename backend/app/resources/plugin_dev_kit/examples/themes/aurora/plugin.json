    "background": {
      "image": "assets/aurora.svg",
      "video": "",
      "size": "cover",
      "position": "center",
      "repeat": "no-repeat",
      "dim": 0.25,
      "blur": 2
    },
    "surface": {
      "opacity": 0.82,
      "blur": 14
    },
    "typography": {
      "body": "",
      "heading": "",
      "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "preview": "assets/preview.svg"
